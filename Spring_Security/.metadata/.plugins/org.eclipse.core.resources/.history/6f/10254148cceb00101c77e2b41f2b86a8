package com.springSecurity.springController;

import org.springframework.boot.CommandLineRunner;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Component;

import com.springSecurity.Dao.SecurityUserDAO;
import com.springSecurity.Entity.Users;

@Component
public class UserPassAdd {
	
	public CommandLineRunner addingUserPass(SecurityUserDAO serDao,PasswordEncoder passwordEncoder) {
		 return args -> {
			 System.out.print("Default user creation");
	            if (serDao.findByUserName("admin").isEmpty()) {
	                Users admin = new Users();
	                admin.setUserName("admin");
	                admin.setUserPass(passwordEncoder.encode("admin1234")); // Securely store password
	                admin.setRole("Admin");

	                serDao.save(admin);
	                System.out.println("Default admin user created!");
	            }
	            if (serDao.findByUserName("user").isEmpty()) {
	                Users admin = new Users();
	                admin.setUserName("user");
	                admin.setUserPass(passwordEncoder.encode("user1234")); // Securely store password
	                admin.setRole("Admin");

	                serDao.save(admin);
	                System.out.println("Default admin user created!");
	            }
	        };
		
	}

}
